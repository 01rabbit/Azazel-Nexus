# vim:syntax=apparmor
# AppArmor profile for azazel-decoyd.service (#196 G3,
# docs/deception-exposure-grant.md §7). Attached by the unit's
# `AppArmorProfile=azazel-decoyd` (no `-`): a start without this profile
# loaded fails. Installed to /etc/apparmor.d/ by packaging/install.sh and
# loaded at boot by apparmor.service. The activation pass never grants this
# unit in this build.
#
# The decoy runs as azdecoy with no capability, inside the decoy network
# namespace. It listens (IPv4, TCP), reads this boot's isolation record and
# its own namespace, and connects once per interaction to the intake's decoy
# socket. It writes no file.
#
# The intake's socket is /var/lib/azazel/run/decoy-intake/decoy-intake.sock,
# under a path whose writes are denied below. INFERRED: on Debian 13's
# kernel a connect to a path socket is mediated by `network unix stream`
# only, not by file rules, so the deny does not touch the report; on a
# kernel with fine-grained af_unix mediation it would refuse the report
# (fail closed: the decoy's interactions are not reported, nothing widens).
# VM item (G4).
#
# INFERRED marks a rule that was not confirmed on a kernel; the exact rules
# are fixed on the VM (G4, §11 item 4). A VM run is not hardware evidence.

abi <abi/4.0>,

include <tunables/global>

profile azazel-decoyd {
  include <abstractions/base>

  # --- What the gate claims (§7). Explicit denies; a deny outranks every
  # --- allow, here and in any include.
  deny /run/azazel-activation{,/**} wlk,
  deny /etc/systemd{,/**} wlk,
  deny /usr/lib/systemd{,/**} wlk,
  deny /lib/systemd{,/**} wlk,
  deny /run/systemd/{system,system.control,transient}{,/**} wlk,
  deny /etc/azazel{,/**} wlk,
  deny /var/lib/azazel{,/**} wlk,
  deny /run/dbus/system_bus_socket rw,
  deny /run/systemd/private rw,
  deny dbus,
  deny ptrace,
  deny capability mac_admin,
  deny capability mac_override,
  deny /sys/kernel/security{,/**} wlk,
  deny change_profile,
  # --- end of the gate's claims.

  # No capability at all, as in the unit.
  deny capability,

  # Its listener (IPv4 TCP) and its one AF_UNIX connect to the intake.
  network inet stream,
  network unix stream,

  # Its own body: the fixed wrapper, the interpreter and the installed
  # package. INFERRED: the venv at /opt/azazel-nexus/venv (operations.md) and
  # Debian 13's python3 under /usr.
  /usr/libexec/azazel/az-decoyd r,
  /usr/bin/python3* mrix,
  /usr/lib/python3{,.[0-9]*}/** mr,
  /usr/lib/@{multiarch}/** mr,
  /opt/azazel-nexus/venv/** mr,
  @{PROC}/@{pid}/fd/ r,
  deny /usr/** w,
  deny /opt/** w,

  # This boot's isolation record, read only (§14).
  @{PROC}/sys/kernel/random/boot_id r,
  /run/azazel-decoy-isolation/ r,
  /run/azazel-decoy-isolation/isolation.json r,

  # Its own namespace check (decoy_netns): its namespace and its links.
  # PID 1's namespace stays unreadable (ptrace is denied above), which the
  # check already treats as "not readable".
  owner @{PROC}/@{pid}/ns/net r,
  owner @{PROC}/@{pid}/net/dev r,
  /run/netns/azazel-decoy r,

  # systemd's stop. INFERRED: the peer label of PID 1 on Debian 13.
  signal (receive) peer=unconfined,
}
