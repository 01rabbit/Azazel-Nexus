# vim:syntax=apparmor
# AppArmor profile for azazel-decoy-verify.service (#196 G2,
# docs/deception-exposure-grant.md §6.1 and §7). Attached by the unit's
# `AppArmorProfile=azazel-decoy-verify` (no `-`) and `AssertSecurity=apparmor`:
# with AppArmor enabled a start without this profile loaded fails, and with
# AppArmor disabled the assertion fails it, so the unit never runs
# unconfined. Installed to /etc/apparmor.d/ by packaging/install.sh and
# loaded at boot by apparmor.service. The activation pass never grants the
# decoy units in this build, and nothing else starts this one.
#
# The verify unit runs the network helper's executable with the one word
# `verify`, root with CAP_NET_ADMIN in the host network namespace. It is the
# helper's profile without its one writable place: it lists the decoy table,
# the host's links, the IPv4 routing rules and the main table's routes with
# fixed nft and ip commands, reads forwarding and proxy_arp under
# /proc/sys/net, and writes nothing. The isolation record stays the
# helper's; this profile may not even read its directory.
#
# `attach_disconnected` (G4, docs/deception-exposure-grant.md §11): under
# systemd's sandbox (PrivateDevices=, PrivateTmp=, ProtectSystem=) a path can
# be disconnected from the process's root; the verify unit's `/dev/null` was
# refused as "Failed name lookup - disconnected path" (VM-checked on Debian
# 13 with AppArmor 4.1; a mechanism check, not hardware evidence). With the
# flag the path is named from its own mount's root, as if that were `/`. It
# only names the object: every rule below, the denies included, still
# applies to that name. What it could alias is a file reached through a
# detached mount that names itself as something else; making such a mount
# takes CAP_SYS_ADMIN and a `mount` rule, and this profile has neither.
#
# INFERRED marks a rule that was not confirmed on a kernel; the exact rules
# are fixed on the VM (G4, §11 item 4). A VM run is not hardware evidence.

abi <abi/4.0>,

include <tunables/global>

profile azazel-decoy-verify flags=(attach_disconnected) {
  include <abstractions/base>

  # --- What the gate claims (§7). Explicit denies; a deny outranks every
  # --- allow, here and in any include.
  deny /run/azazel-activation{,/**} wlk,
  deny /etc/systemd{,/**} wlk,
  deny /usr/lib/systemd{,/**} wlk,
  deny /lib/systemd{,/**} wlk,
  deny /run/systemd/{system,system.control,transient}{,/**} wlk,
  deny /etc/azazel{,/**} wlk,
  deny /var/lib/azazel{,/**} wlk,
  deny /run/dbus/system_bus_socket rw,
  deny /run/systemd/private rw,
  deny dbus,
  deny ptrace,
  deny capability mac_admin,
  deny capability mac_override,
  deny /sys/kernel/security{,/**} wlk,
  deny change_profile,
  # --- end of the gate's claims.

  # It writes nothing: not the helper's isolation record, and not anything
  # else under /run.
  deny /run/azazel-decoy-isolation{,/**} wlk,
  deny @{PROC}/sys/** wlk,

  # Exactly the unit's bounding set, and netlink as its only family. No
  # mount of any kind. INFERRED: that a listing needs net_admin (§11 item 5).
  capability net_admin,
  network netlink raw,

  # Its own body: the fixed wrapper, the interpreter and the installed
  # package. The venv at /opt/azazel-nexus/venv (operations.md) and Debian
  # 13's python3.13; INFERRED: that nothing else is read at startup.
  /usr/libexec/azazel/az-decoy-netd r,
  # decoy_apparmor.PROFILE_INTERPRETER and PROFILE_PYTHON_ROOTS; the
  # installer refuses wrappers that resolve elsewhere.
  /usr/bin/python3.13 mrix,
  /usr/lib/python3.13/** mr,
  /usr/lib/@{multiarch}/** mr,
  /opt/azazel-nexus/venv/** mr,
  @{PROC}/@{pid}/fd/ r,
  deny /usr/** w,
  deny /opt/** w,

  # Its scope (#196 G2, grant §6.1): the same source file as the helper's,
  # handed to it as its own credential `decoy-scope` (`LoadCredential=`),
  # read only, from the fixed path
  # `decoy_scope.VERIFY_SCOPE_CREDENTIAL_PATH`; the directory is opened
  # first (no link).
  /run/credentials/azazel-decoy-verify.service/ r,
  /run/credentials/azazel-decoy-verify.service/decoy-scope r,

  # Reachability R4: forwarding and proxy_arp of every interface, IPv4 and
  # IPv6, read only (`decoy_watch.read_sysctls`). INFERRED: the exact files
  # the kernel lists there (§11 item 7 of the reachability design).
  @{PROC}/sys/net/ipv4/conf/ r,
  @{PROC}/sys/net/ipv4/conf/*/ r,
  @{PROC}/sys/net/ipv4/conf/*/forwarding r,
  @{PROC}/sys/net/ipv4/conf/*/proxy_arp r,
  @{PROC}/sys/net/ipv6/ r,
  @{PROC}/sys/net/ipv6/conf/ r,
  @{PROC}/sys/net/ipv6/conf/*/ r,
  @{PROC}/sys/net/ipv6/conf/*/forwarding r,

  # The fixed ip and nft read-backs (decoy_network.WATCH_READS) run under
  # this same profile and need nothing it does not have.
  /usr/bin/ip mrix,
  /usr/sbin/nft mrix,
  /etc/iproute2/** r,
  /usr/share/iproute2/** r,

  # Its own children (the step deadline), and systemd's stop. INFERRED: the
  # peer label of PID 1 on Debian 13.
  signal (send) set=(kill) peer=azazel-decoy-verify,
  signal (receive) peer=azazel-decoy-verify,
  signal (receive) peer=unconfined,
}
