# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# The one account the Knowledge Context broker serves.
# It answers the entry service alone, asks the broker only for the observed ATT&CK technique ids and re-runs the model-free core.
# It runs no model, holds no model, admission or mission path, starts no process and has no network namespace.

[Unit]
Description=Azazel-Nexus M.I.O. observation-origin Knowledge Context service
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/knowledge-context-consumer.md
After=azazel-activated.service
ConditionPathExists=/run/azazel-activation/granted/azazel-mio-contextobsd.service
Requires=azazel-activated.service

[Service]
Type=notify
User=azmioctx
SupplementaryGroups=azknowledge-context-client
ExecStart=/usr/libexec/azazel/az-mio-contextobsd
PrivateNetwork=yes
TimeoutStartSec=30s
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
LimitNOFILE=256
LimitFSIZE=16777216
LogRateLimitIntervalSec=30
LogRateLimitBurst=50
LogExtraFields=AZ_SERVICE=mio-contextobs
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/azazel/state/mio-contextobs
ReadWritePaths=/var/lib/azazel/run/mio-contextobs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
