# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# Can mask and cannot unmask.
# Masking a unit it does not own is brokered by the activation controller's socket, so it needs no privilege of its own.

[Unit]
Description=Azazel-Nexus degradation coordinator
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/capability-model.md
After=azazel-auditd.service
Requires=azazel-activated.service

[Service]
Type=notify
User=azwatch
ExecStart=/usr/libexec/azazel/az-watchdog
RuntimeDirectory=azazel
RuntimeDirectoryMode=0750
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/azazel/run
ReadWritePaths=/var/lib/azazel/state/watchdog
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
