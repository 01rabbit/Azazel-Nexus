[Unit]
Description=Azazel-Nexus local incident explanation
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/integration-loop.md
After=azazel-activated.service
ConditionPathExists=/run/azazel-activation/granted/azazel-incident-explaind.service
Requires=azazel-activated.service

[Service]
Type=notify
User=azexplain
SupplementaryGroups=azincident-read azknowledge-read azaudit-submit azmio-advise
ExecStart=/usr/libexec/azazel/az-incident-explaind
PrivateNetwork=yes
TimeoutStartSec=30s
MemoryMax=256M
TasksMax=32
LimitNOFILE=256
LimitFSIZE=128M
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/azazel/incident-explain
ReadWritePaths=/var/lib/azazel/run/incident-explain-status
ReadWritePaths=-/var/lib/azazel/run/ui-read/incident-explain
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
