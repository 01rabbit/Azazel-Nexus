# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# Runs once.
# It holds CAP_NET_ADMIN alone, as a bounding set and never as an ambient capability, in the host network namespace: with fixed nft and ip commands it loads the decoy table first, then sets up az-decoy0 and attaches the host end of the veth pair the namespace unit made; ExecStop cuts the path and then removes the table.
# Its one input is the closed exposure scope, the credential decoy-scope, decoded strictly; the table is rendered from it as one transaction, and a missing scope file fails the start.
# After building it reads back the table and the host's links with two fixed commands and writes this boot's isolation record, fixed results and the scope's digest only, to its runtime directory, which the decoy requires before it listens; a check that does not pass undoes the build.
# It reads no decoy observation and no Edge decision.
# It is root, so netlink is its only address family (any netlink protocol, not only route and nftables) and it has no AF_UNIX socket that could reach the service manager, whose private sockets are also inaccessible to it.
# It starts only with AppArmor enabled and its profile azazel-decoy-netd loaded (AppArmorProfile= without a dash, AssertSecurity=apparmor).
# The activation pass grants this unit only with the whole exposure tier, on a verified v3 approval and its exposure evidence (#196 G6).

[Unit]
Description=Azazel-Nexus Deception Lite network helper
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/deception-redirect-prerequisites.md
After=azazel-activated.service
After=azazel-decoy-nsd.service
After=nftables.service
After=firewalld.service
After=netfilter-persistent.service
ConditionPathExists=/run/azazel-activation/granted/azazel-decoy-netd.service
AssertSecurity=apparmor
Requires=azazel-activated.service
Requires=azazel-decoy-nsd.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/libexec/azazel/az-decoy-netd
AppArmorProfile=azazel-decoy-netd
RuntimeDirectory=azazel-decoy-isolation
RuntimeDirectoryMode=0755
RemainAfterExit=yes
TimeoutStartSec=30s
ExecStop=/usr/libexec/azazel/az-decoy-netd stop
LoadCredential=decoy-scope:/run/azazel-activation/decoy-scope.json
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
InaccessiblePaths=-/run/dbus/system_bus_socket
InaccessiblePaths=-/run/systemd/private
RestrictAddressFamilies=AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
