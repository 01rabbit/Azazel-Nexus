[Unit]
Description=Azazel-Nexus optional Knowledge Context egress broker
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/knowledge-context-consumer.md
After=azazel-activated.service
ConditionPathExists=/run/azazel-activation/granted/azazel-knowledge-contextd.service
Requires=azazel-activated.service

[Service]
Type=notify
User=azknowledgeegress
ExecStart=/usr/libexec/azazel/az-knowledge-contextd
KillMode=control-group
TimeoutStopSec=10s
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
LogRateLimitIntervalSec=30
LogRateLimitBurst=30
LogExtraFields=AZ_SERVICE=knowledge-context
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/azazel/state/knowledge-context
ReadWritePaths=/var/lib/azazel/run/knowledge-context
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
