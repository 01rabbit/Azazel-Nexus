[Unit]
Description=Azazel-Nexus Knowledge Lite read service
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/knowledge-lite-consumer.md
After=azazel-activated.service
ConditionPathExists=/run/azazel-activation/granted/azazel-knowledge-lited.service
Requires=azazel-activated.service

[Service]
Type=notify
User=azknowledge
ExecStart=/usr/libexec/azazel/az-knowledge-lited
ReadOnlyPaths=/var/lib/azazel/lite-trust
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/azazel/knowledge
ReadWritePaths=/var/lib/azazel/run/knowledge
ReadWritePaths=/var/lib/azazel/run/knowledge-read
ReadWritePaths=/var/lib/azazel/state/knowledge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
