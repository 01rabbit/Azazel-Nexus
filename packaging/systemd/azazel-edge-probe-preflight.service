# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# Not governed by the activation controller: it runs before it, at every boot, so that the pass reads Edge health from this boot (probe contract v2 binds the result to the boot id).
# It runs the same fixed az-edge-probed as the same unprivileged azprobe account, in the same sandbox as azazel-edge-probed.service, and writes only the same result leaf.
# It opens no network socket: `AF_UNIX` is all it is allowed, and `IPAddressDeny=any` holds.
# It grants nothing; a result it writes only narrows what the pass may grant, and its failure leaves Edge withheld.

[Unit]
Description=Azazel-Nexus Edge probe boot preflight
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/edge-package-verification.md
Before=azazel-activated.service

[Service]
Type=oneshot
User=azprobe
ExecStart=/usr/libexec/azazel/az-edge-probed
TimeoutStartSec=60s
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/azazel/run/edge-probe
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
