# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# Serves verified playbook references for the deterministic handoff.
# It runs no model, holds no model path, starts no process and has no network namespace.
# Model execution stays with the model host and its own wiring and admission, which this unit neither needs nor satisfies.

[Unit]
Description=Azazel-Nexus M.I.O. playbook reference service
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/mio-runtime.md
After=azazel-activated.service
ConditionPathExists=/run/azazel-activation/granted/azazel-mio-referenced.service
Requires=azazel-activated.service

[Service]
Type=notify
User=azmioref
SupplementaryGroups=azmission-read
ExecStart=/usr/libexec/azazel/az-mio-referenced
ReadOnlyPaths=-/etc/azazel/mission-pack.json
ReadOnlyPaths=-/data/azazel/mission-packs
PrivateNetwork=yes
TimeoutStartSec=30s
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
LimitNOFILE=256
LimitFSIZE=16777216
LogRateLimitIntervalSec=30
LogRateLimitBurst=50
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/azazel/state/mio-reference
ReadWritePaths=/var/lib/azazel/run/mio-reference
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
