# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# Runs once and exits.
# It executes exactly two things -- the Edge health contract at a fixed path, and a read-only D-Bus property query -- and it writes one bounded file.
# It is not root, it takes no argument that could redirect it, and `AF_UNIX` is all it needs: the D-Bus connection it reads unit state over is one.
# It writes only into its own result leaf, which the operator group may read, and the result holds no secret: a version, a digest, two verdicts and their reasons.

[Unit]
Description=Azazel-Nexus Edge health and running probe
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/edge-package-verification.md
After=azazel-activated.service
Requires=azazel-activated.service

[Service]
Type=oneshot
User=azprobe
ExecStart=/usr/libexec/azazel/az-edge-probed
RuntimeDirectory=azazel
RuntimeDirectoryMode=0750
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/azazel/run/edge-probe
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
