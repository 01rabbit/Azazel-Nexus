# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# Runs once.
# The only unit that holds CAP_SYS_ADMIN, as a bounding set and never as an ambient capability: it would create the decoy network namespace at /run/netns/azazel-decoy and do nothing else.
# It opens no socket of any family, writes only /run/netns, may create only a network namespace, and its syscall filter adds only mount, umount2 and unshare to the shared set and takes back what that act never needs.
# Its body is a later phase of #196; in this build the executable refuses and exits, and the activation pass never grants this unit.

[Unit]
Description=Azazel-Nexus Deception Lite namespace
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/deception-redirect-prerequisites.md
After=azazel-activated.service
ConditionPathExists=/run/azazel-activation/granted/azazel-decoy-nsd.service
Requires=azazel-activated.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/libexec/azazel/az-decoy-nsd
RemainAfterExit=yes
TimeoutStartSec=30s
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
InaccessiblePaths=-/run/dbus -/run/systemd
RestrictAddressFamilies=none
ReadWritePaths=/run/netns
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=net
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service mount umount2 unshare
SystemCallFilter=~@aio @chown @ipc @keyring @memlock @network-io @setuid @timer capset setns
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
