# Generated from azazel_nexus_runtime.hardening. Do not edit by hand:
# tests/unit/test_runtime_hardening.py compares this file against what
# the declaration renders, and a hand edit is a difference.
#
# Runs once.
# The only unit that holds CAP_SYS_ADMIN, with CAP_NET_ADMIN, as a bounding set and never as an ambient capability: it creates the decoy network namespace at /run/netns/azazel-decoy, the veth pair with the decoy's end inside it, and the inside's fixed address and route.
# It runs /usr/bin/ip and nothing else: six fixed ExecStart lines, run in order until one fails, and two fixed ExecStopPost lines, which remove the pair and the namespace after every stop and after a start that failed or timed out; no Python body, so only ip holds its two capabilities.
# Netlink is its only address family, though that admits every netlink protocol, nftables included; it may create only a network namespace and the mount namespace ip -n makes for itself, and its syscall filter adds only mount, umount2, unshare and setns to the shared set and takes back what that act never needs.
# It is the one unit without the shared file-system sandbox: a mount namespace would keep the namespace handle from the host, and with CAP_SYS_ADMIN and mount that sandbox was never a wall for it.
# A compromised ip would be host root; its containment is fixed command lines that take no input, static review and its AppArmor profile azazel-decoy-nsd, which denies writes to the activation state, the unit files and the ledgers and any reach to the service manager; it starts only with AppArmor enabled and that profile loaded (AppArmorProfile= without a dash, AssertSecurity=apparmor).
# The activation pass never grants this unit in this build.

[Unit]
Description=Azazel-Nexus Deception Lite namespace
Documentation=https://github.com/01rabbit/Azazel-Nexus/blob/main/docs/deception-redirect-prerequisites.md
After=azazel-activated.service
ConditionPathExists=/run/azazel-activation/granted/azazel-decoy-nsd.service
AssertSecurity=apparmor
Requires=azazel-activated.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/ip netns add azazel-decoy
ExecStart=/usr/bin/ip link add name az-decoy-host0 type veth peer name az-decoy-ns0 netns azazel-decoy
ExecStart=/usr/bin/ip -n azazel-decoy link set dev lo up
ExecStart=/usr/bin/ip -n azazel-decoy address add 10.255.196.2/30 dev az-decoy-ns0
ExecStart=/usr/bin/ip -n azazel-decoy link set dev az-decoy-ns0 up
ExecStart=/usr/bin/ip -n azazel-decoy route add default via 10.255.196.1 dev az-decoy-ns0
AppArmorProfile=azazel-decoy-nsd
RemainAfterExit=yes
TimeoutStartSec=30s
TimeoutStopSec=30s
ExecStopPost=-/usr/bin/ip link delete az-decoy-host0
ExecStopPost=/usr/bin/ip netns delete azazel-decoy
RestrictRealtime=yes
RestrictAddressFamilies=AF_NETLINK
NoNewPrivileges=yes
RestrictNamespaces=net mnt
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service mount umount2 unshare setns
SystemCallFilter=~@aio @chown @ipc @keyring @memlock @setuid @timer capset
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN
AmbientCapabilities=
IPAddressDeny=any
UMask=0027

[Install]
WantedBy=multi-user.target
