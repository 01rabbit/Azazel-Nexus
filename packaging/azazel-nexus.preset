# systemd preset for Azazel-Nexus.
#
# IMPLEMENTATION_SPEC 2.3: installation MUST NOT start an operational network
# service. `disable` here is what makes `systemctl preset-all` -- which a
# distribution may run at any time -- leave the governed units alone instead
# of enabling them because they carry an [Install] section.
#
# The activation controller is the one exception, and it is exact rather than
# a glob: it opens no socket and reaches no interface, and it is what
# revalidates the current generation on every boot. A preset that enabled
# `azazel-*` would have re-enabled the operational units on the next
# preset-all, which is the whole failure this file prevents.
#
# The Edge probe's boot preflight is the second, also exact: it is not a
# governed unit, opens no network socket (AF_UNIX only, IPAddressDeny=any),
# runs the fixed read-only probe as azprobe before the controller, and can
# only narrow what the controller grants (#206 P5).
#
# The activation recheck's timer is the third, also exact: it periodically
# evaluates whether the Knowledge Context broker's grant still holds and can
# only withdraw it (stop contract). A stop that waits for an operator to
# enable a timer is not a stop, so the preset enables it.
#
# The read-only operator UI (U5) is not governed and is disabled: an operator
# enables azazel-ui.socket explicitly. Listed so preset-all never enables it.
disable azazel-commissiond.service
disable azazel-auditd.service
disable azazel-auditd-loop.service
disable azazel-watchdog.service
disable azazel-edge-core.service
disable azazel-edge-probed.service
disable azazel-edge-intaked.service
disable azazel-incident-explaind.service
disable azazel-model-fetchd.service
disable azazel-mio-locald.service
disable azazel-mio-remoted.service
disable azazel-knowledge-contextd.service
disable azazel-mio-entryd.service
disable azazel-mio-referenced.service
disable azazel-knowledge-lited.service
disable azazel-decoy-nsd.service
disable azazel-decoy-netd.service
disable azazel-decoyd.service
disable azazel-ui.socket
disable azazel-ui.service
enable azazel-activated.service
enable azazel-edge-probe-preflight.service
enable azazel-activation-recheck.timer
